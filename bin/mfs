#!/usr/bin/env bash
# Run the mfs harness inside Docker. The host needs only docker (and the
# nvidia container runtime for GPU examples).
#
#   bin/mfs image              (re)build the base image
#   bin/mfs <harness command>  see harness/cli.mjs
#
# Environment:
#   MFS_IMAGE    image to run          (default mfs-base:latest)
#   MFS_MEMORY   container memory cap  (default 8g)
#   MFS_CPUS     container CPU quota   (default 8)
#   MFS_PORT     host port for serve   (default 8080)
#   MFS_SOURCES  host dir mounted read-only at the same path, for raw data
#                (default /sata_hdd_24tb when it exists)
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
IMAGE=${MFS_IMAGE:-mfs-base:latest}

if [[ "${1:-}" == image ]]; then
  exec docker build -t "$IMAGE" "$ROOT/docker/base"
fi
docker image inspect "$IMAGE" >/dev/null 2>&1 || docker build -t "$IMAGE" "$ROOT/docker/base"

args=(--rm --init -i
  --memory "${MFS_MEMORY:-8g}" --cpus "${MFS_CPUS:-8}" --shm-size 2g
  -u "$(id -u):$(id -g)" -e HOME=/tmp
  -v "$ROOT:$ROOT" -w "$ROOT")
[[ -t 0 && -t 1 ]] && args+=(-t)
if docker info --format '{{range $k,$v := .Runtimes}}{{$k}} {{end}}' | grep -qw nvidia; then
  args+=(--gpus all -e NVIDIA_DRIVER_CAPABILITIES=all)
fi
SOURCES=${MFS_SOURCES-/sata_hdd_24tb}
[[ -n "$SOURCES" && -d "$SOURCES" ]] && args+=(-v "$SOURCES:$SOURCES:ro")
[[ "${1:-}" == serve ]] && args+=(-p "${MFS_PORT:-8080}:${2:-8080}")
[[ -n "${MFS_PAGE_QUERY:-}" ]] && args+=(-e "MFS_PAGE_QUERY=$MFS_PAGE_QUERY")
[[ -n "${MFS_CHROME_FLAGS:-}" ]] && args+=(-e "MFS_CHROME_FLAGS=$MFS_CHROME_FLAGS")
[[ -n "${DISPLAY:-}" && -d /tmp/.X11-unix ]] && args+=(-e "DISPLAY=$DISPLAY" -v /tmp/.X11-unix:/tmp/.X11-unix)

exec docker run "${args[@]}" "$IMAGE" node harness/cli.mjs "$@"
