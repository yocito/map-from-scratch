{
  "id": "04-osm-node-density",
  "request": "東京23区の OSM の全ノード（約 966 万点）の密度をヒートマップで見たい。拡大・移動したら、タイルの粗い集計ではなく、その画面の解像度で数え直してほしい。PC のブラウザで。",
  "runtime": "browser",
  "bake": ["node", "examples/04-osm-node-density/bake.mjs"],
  "run": {
    "page": "examples/04-osm-node-density/index.html",
    "viewport": { "width": 1280, "height": 800, "deviceScaleFactor": 1, "mobile": false }
  },
  "iterations": 3,
  "footprint": {
    "code": ["examples/04-osm-node-density/density.js"],
    "data": ["data/baked/04-osm-node-density/nodes.bin"]
  },
  "budgets": {
    "code_gzip_bytes": { "max": 4000 },
    "data_gzip_bytes": { "max": 20000000 },
    "first_frame_ms": { "stat": "p50", "max": 2000 },
    "frame_ms": { "stat": "p95", "max": 8.3 },
    "whole_frame_ms": { "stat": "p95", "max": 8.3 }
  }
}
