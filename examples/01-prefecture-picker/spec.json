{
  "id": "01-prefecture-picker",
  "request": "自治体の観光サイトの記事に、都道府県を選ぶ日本地図を埋め込みたい。クリックやタップで選んだ都道府県で記事を絞り込む。外部ライブラリは入れられないし、ページが重くなるのは困る。",
  "runtime": "browser",
  "gpu": "none",
  "bake": ["node", "examples/01-prefecture-picker/bake.mjs"],
  "run": {
    "page": "examples/01-prefecture-picker/index.html",
    "viewport": { "width": 390, "height": 844, "deviceScaleFactor": 3, "mobile": true },
    "cpuThrottle": 4
  },
  "iterations": 10,
  "footprint": {
    "code": ["examples/01-prefecture-picker/picker.js"],
    "data": ["data/baked/01-prefecture-picker/prefectures.json"]
  },
  "budgets": {
    "code_gzip_bytes": { "max": 1500 },
    "data_bytes": { "max": 16000 },
    "first_frame_ms": { "stat": "p50", "max": 300 },
    "redraw_ms": { "stat": "p95", "max": 2 },
    "frame_interval_ms": { "stat": "p95", "max": 20 },
    "pick_ms": { "stat": "p95", "max": 1 }
  }
}
