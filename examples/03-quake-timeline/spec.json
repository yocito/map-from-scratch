{
  "id": "03-quake-timeline",
  "request": "2025年に世界で起きた M4.5 以上の地震を、地図の上で時間を追って再生したい。再生・一時停止と、スライダーで好きな日時に飛べるように。PC のブラウザで見る。",
  "runtime": "browser",
  "bake": ["node", "examples/03-quake-timeline/bake.mjs"],
  "run": {
    "page": "examples/03-quake-timeline/index.html",
    "viewport": { "width": 1280, "height": 800, "deviceScaleFactor": 1, "mobile": false }
  },
  "iterations": 5,
  "footprint": {
    "code": ["examples/03-quake-timeline/quake.js"],
    "data": ["data/baked/03-quake-timeline/land.bin", "data/baked/03-quake-timeline/quakes.bin", "data/baked/03-quake-timeline/quakes.json"]
  },
  "budgets": {
    "code_gzip_bytes": { "max": 4000 },
    "data_gzip_bytes": { "max": 600000 },
    "first_frame_ms": { "stat": "p50", "max": 500 },
    "frame_ms": { "stat": "p95", "max": 8.3 },
    "cpu_ms": { "stat": "p95", "max": 0.5 }
  }
}
