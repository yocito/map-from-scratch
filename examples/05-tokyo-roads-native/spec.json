{
  "id": "05-tokyo-roads-native",
  "request": "ノート PC のデスクトップアプリとして、東京23区の道路を1本も間引かずに表示して、144Hz のモニタでカクつかずにパン・ズームしたい。ブラウザは使いたくない。起動は一瞬で。",
  "runtime": "native",
  "bake": ["node", "examples/05-tokyo-roads-native/bake.mjs"],
  "build": ["sh", "-c", "mkdir -p build && cc -std=c11 -D_GNU_SOURCE -O2 -s -Wall -Wextra -o build/roads examples/05-tokyo-roads-native/roads.c -lEGL -lGLESv2 -lX11 -lm"],
  "run": { "cmd": ["build/roads", "--bench", "data/baked/05-tokyo-roads-native/roads.bin"] },
  "iterations": 5,
  "footprint": {
    "code": ["build/roads"],
    "data": ["data/baked/05-tokyo-roads-native/roads.bin"]
  },
  "budgets": {
    "first_frame_ms": { "stat": "max", "max": 300 },
    "frame_ms": { "stat": "p95", "max": 6.9 },
    "whole_frame_ms": { "stat": "p95", "max": 6.9 },
    "peak_rss_mb": { "stat": "p50", "max": 150 },
    "code_bytes": { "max": 40000 }
  }
}
